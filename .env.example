# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string (see README for how to get one, free tier)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wardrobe

# Any long random string — used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

# Render/Railway set this automatically; 4000 is fine for local dev
PORT=4000
